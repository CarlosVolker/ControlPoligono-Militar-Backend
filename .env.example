# =============================================================
# PoligonoTiro Backend — variables de entorno
# Copiar a .env y reemplazar los valores reales antes de levantar.
# =============================================================

# Seguridad
SECRET_KEY=CHANGE-ME-PLEASE-USE-A-LONG-RANDOM-STRING
DEBUG=False

# Zona horaria del servidor
# Descomenta la que corresponda y borra las demás (o escribe la tuya):
#
# --- Chile ---
TIME_ZONE=America/Santiago
# TIME_ZONE=America/Punta_Arenas    # Magallanes (UTC-3, sin cambio horario)
#
# --- Argentina ---
# TIME_ZONE=America/Argentina/Buenos_Aires
#
# --- Perú / Colombia / Ecuador ---
# TIME_ZONE=America/Lima
# TIME_ZONE=America/Bogota
# TIME_ZONE=America/Guayaquil
#
# --- Bolivia ---
# TIME_ZONE=America/La_Paz
#
# --- Brasil ---
# TIME_ZONE=America/Sao_Paulo
#
# --- México ---
# TIME_ZONE=America/Mexico_City
#
# --- España ---
# TIME_ZONE=Europe/Madrid
#
# --- UTC (sin ajuste horario) ---
# TIME_ZONE=UTC

# Base de datos
# PostgreSQL en producción; SQLite en desarrollo:
#   DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:pass@db.intranet:5432/poligono_militar

# SMTP (para flujo de recuperación de contraseña)
EMAIL_HOST=smtp.intranet
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=poligono@intranet
EMAIL_HOST_PASSWORD=CHANGE-ME

# Hosts y CORS (el frontend corre en otro dominio/puerto)
ALLOWED_HOSTS=poligono-api.intranet,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://poligono.intranet,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://poligono.intranet,http://localhost:3000

# Cookies de sesión y CSRF
# SECURE=True OBLIGATORIO en producción (requiere HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Onboarding: contraseña temporal asignada a usuarios nuevos
DEFAULT_TEMP_PASSWORD=User1234

# Feature flags de autorización (dejar en True en producción)
AUTHZ_USE_PERMISSION_MODEL=True
AUTHZ_USE_UNIT_MEMBERSHIP=True

# Auditoría de cambios (django-auditlog)
# 0 = sin borrado automático. En producción recomendado: 730 (2 años)
AUDITLOG_MAX_AGE_DAYS=730

# Protección contra fuerza bruta (django-axes)
# FAILURE_LIMIT: intentos antes del bloqueo (recomendado: 5)
# COOLOFF_MINUTES: minutos de bloqueo (recomendado: 60 en producción)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=60
